# Copy this file to .env and adjust as needed. Never commit the real .env.

# Base URL of the local Ollama server.
# - Running the CLI directly on the Mac host: http://localhost:11434
# - Running the CLI inside Docker on macOS (Ollama still on the host):
#     http://host.docker.internal:11434
LOCAL_AI_OLLAMA_HOST=http://localhost:11434

# Model tag to use. Confirm the current tag and license at
# https://ollama.com/library before relying on it.
LOCAL_AI_MODEL_NAME=qwen3:4b

# Request timeout, in seconds, for calls to the inference backend.
# qwen3:4b is a "thinking" model with a reasoning phase before the final
# answer; on a MacBook Air M4 a single response took over two minutes
# in testing. 180s is a safer default than a short timeout that cuts
# off a response that was actually still working.
LOCAL_AI_TIMEOUT_SECONDS=180

# Set to true to enable verbose debug logging. Never enable in shared
# environments: debug mode may log prompt/response content.
LOCAL_AI_DEBUG=false
